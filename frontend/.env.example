# Public deployment boundaries (exact origins, no paths)
VEILPASS_HOST_ORIGIN=http://localhost:3000
VEILPASS_LOGIN_ORIGIN=http://localhost:3000
NEXT_PUBLIC_VEILPASS_LOGIN_ORIGIN=http://localhost:3000

# Two-host local demo: one Next server, three browser origins. Put these values
# in .env.local, then open app-a.localhost:3000 and app-b.localhost:3000.
# VEILPASS_HOST_ORIGIN=http://app-a.localhost:3000,http://app-b.localhost:3000
# VEILPASS_LOGIN_ORIGIN=http://login.localhost:3000
# NEXT_PUBLIC_VEILPASS_LOGIN_ORIGIN=http://login.localhost:3000

# Testnet gate registry
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_VEILPASS_CONTRACT_ID=CC7FUOFBIZ7UIOG7J66QJZCWU3L2MM4GW2HZUHMSF4ZBKOGCVZ4UYJZY
NEXT_PUBLIC_VEILPASS_SOURCE_ACCOUNT=GCUSQB6ZWO633HV7M3EF6BCWSYQMTA65RJU4OMQ435OAQ3WJRIVA43VM
VEILPASS_GATE_IDS=premium-holder
VEILPASS_GATE_EPOCH=1
VEILPASS_CREDENTIAL_ROOT=853beeab108a74b7fe1410d6bebb1a5bdca9ad416ebdf0cc92ab248332ad2bdc

# Asset eligibility rule
VEILPASS_ASSET_CODE=VPT
VEILPASS_ASSET_ISSUER=
VEILPASS_MIN_BALANCE=1

# Secrets: generate unique values; never expose with NEXT_PUBLIC_
VEILPASS_SIMULATOR_KEY=
VEILPASS_ISSUER_SECRET=
VEILPASS_FIXTURE_CREDENTIAL=

# Required for production replay protection and atomic challenge consumption
DATABASE_URL=postgres://veilpass:change-me@localhost:5432/veilpass
